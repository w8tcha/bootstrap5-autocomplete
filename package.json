{
  "name": "bootstrap5-autocomplete",
  "type": "module",
  "version": "1.1.42",
  "description": "Autocomplete for Bootstrap 5",
  "main": "dist/autocomplete.js",
  "types": "./dist/autocomplete.d.ts",
  "exports": {
    "import": "./dist/autocomplete.js",
    "require": "./dist/autocomplete.umd.cjs"
  },
  "scripts": {
    "update-deps": "set npm_config_allow_scripts=&& npm-check -y",
    "test": "vitest",
    "dev": "vite",
    "build": "tsc && vite build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lekoala/bootstrap5-autocomplete"
  },
  "keywords": [
    "DOM",
    "autocomplete",
    "input",
    "bootstrap",
    "bootstrap5",
    "bootstrap 5",
    "es6"
  ],
  "author": "LeKoala",
  "license": "MIT",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "vite": "^8.2.2",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  }
}
